# ---- Fluenta server configuration -----------------------------------------
# Copy to .env and load it with your process manager, or run:
#   node --env-file=.env apps/server/src/index.ts
# Every value is read from the environment at boot.

# Where the server listens
PORT=8787
HOST=0.0.0.0

# Public origin of the deployment. Used for OAuth redirects, invite/reset links
# and the Web Push "mailto" subject. Set this in production.
APP_ORIGIN=https://chat.example.com

# Storage for the SQLite database, uploads and the local mail outbox.
# Defaults to apps/server/data
# FLUENTA_DATA_DIR=/var/lib/fluenta

# Upload ceiling in megabytes (default 25)
# FLUENTA_MAX_UPLOAD_MB=25

# Disable open registration once your community is full
# FLUENTA_REGISTRATION_OPEN=false

# Set to false when the server is exposed directly (no reverse proxy in front),
# so client IPs for rate limiting come from the socket instead of X-Forwarded-For
# FLUENTA_TRUST_PROXY=false

# ---- Google sign-in (optional) --------------------------------------------
# Authorised redirect URI: ${APP_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Transactional email (password resets) --------------------------------
# Either an SMTP URL...
SMTP_URL=
# ...or host/port/user/pass
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fluenta <no-reply@example.com>

# Without SMTP, reset links are written to data/outbox/ so self-hosters can
# still recover an account from the server.
